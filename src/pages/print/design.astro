---
import { loadData } from "../../lib/parser";
import { loadConfig } from "../../lib/parser/configParser";
import { resolveTheme } from "../../themes/registry";

const data = await loadData();
const config = await loadConfig();

const selectedTheme = config.pdf?.theme || config.theme;
const resolvedTheme = resolveTheme(selectedTheme);
const DesignPdfComponent = resolvedTheme.theme.pdf;

const defaultTitle = `${data.profile.name} — Design CV`;
const pageTitle = config.pdf?.filename
  ? config.pdf.filename
      .replace("{name}", data.profile.name)
      .replace("{title}", data.profile.title)
  : defaultTitle;
---

<!doctype html>
<html lang={config.locale || "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
      }
      html, body {
        margin: 0;
        padding: 0;
        background-color: #ffffff;
      }
    </style>
  </head>
  <body>
    <DesignPdfComponent data={data} locale={config.locale} />
  </body>
</html>
