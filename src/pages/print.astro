---
import { loadData } from "../lib/parser";
import { loadConfig } from "../lib/parser/configParser";
import AtsResume from "../components/pdf/AtsResume.astro";

const data = await loadData();
const config = await loadConfig();

const defaultTitle = `${data.profile.name} — ATS Resume`;
const pageTitle = config.pdf?.filename
  ? config.pdf.filename
      .replace("{name}", data.profile.name)
      .replace("{title}", data.profile.title)
  : defaultTitle;
const pdfFormat = config.pdf?.format || "a4";
---

<!doctype html>
<html lang={config.locale || "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
      }
      html, body {
        margin: 0;
        padding: 0;
        background-color: #ffffff;
      }
    </style>
  </head>
  <body>
    <AtsResume data={data} locale={config.locale} format={pdfFormat} />
  </body>
</html>
