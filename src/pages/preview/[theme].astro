---
import { loadData } from "../../lib/parser";
import { loadConfig } from "../../lib/parser/configParser";
import { themes, resolveTheme, type ThemeName } from "../../themes/registry";

export function getStaticPaths() {
  return Object.keys(themes).map((themeName) => ({
    params: { theme: themeName },
  }));
}

const { theme } = Astro.params;
const data = await loadData();
const config = await loadConfig();

const resolvedTheme = resolveTheme(theme);
const WebComponent = resolvedTheme.theme.web;
---

<!doctype html>
<html lang={config.locale || "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{data.profile.name} — Preview {resolvedTheme.themeName}</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
      }
      html, body {
        margin: 0;
        padding: 0;
      }
    </style>
  </head>
  <body>
    <main>
      <WebComponent data={data} locale={config.locale} config={config} />
    </main>
  </body>
</html>
