---
import type { CVData } from "../../lib/cvSchema";
import type { DotcvConfig } from "../../lib/configSchema";
import { getTranslations } from "../../lib/i18n";

interface Props {
  data: CVData;
  locale?: string;
  config?: DotcvConfig;
}

const { data, locale = "en", config } = Astro.props;
const { profile, experience, education, skills, projects, certifications, languages } = data;
const t = getTranslations(locale);

const showAtsButton = config?.pdf?.showAtsButton ?? true;
const showDesignButton = config?.pdf?.showDesignButton ?? true;
const showActionBar = showAtsButton || showDesignButton;

function formatDate(dateStr?: string | null, isCurrent?: boolean) {
  if (isCurrent) return t("present");
  if (!dateStr) return "";
  return dateStr;
}
---

<div class="cv-sidebar-layout">
  <!-- Left column / Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-profile">
      {profile.avatar && (
        <div class="avatar-box">
          <img src={profile.avatar} alt={profile.name} class="avatar" />
        </div>
      )}
      <h1 class="sidebar-name">{profile.name}</h1>
      <p class="sidebar-title">{profile.title}</p>
      {showActionBar && (
        <div class="sidebar-actions">
          {showAtsButton && (
            <button type="button" class="sidebar-pdf-btn sidebar-pdf-primary" data-print-pdf="ats" aria-label="Download ATS PDF" title="ATS-friendly resume for job applications">
              {t("downloadAtsPdf")}
            </button>
          )}
          {showDesignButton && (
            <button type="button" class="sidebar-pdf-btn sidebar-pdf-secondary" data-print-pdf="design" aria-label="Download Design PDF" title="Visual portfolio PDF matching current theme">
              {t("downloadDesignPdf")}
            </button>
          )}
        </div>
      )}
    </div>

    <!-- Contact -->
    <div class="sidebar-section">
      <h2 class="sidebar-heading">{t("contact")}</h2>
      <div class="contact-stack">
        {profile.email && (
          <a href={`mailto:${profile.email}`} class="contact-link">
            <span class="icon">✉</span>
            <span>{profile.email}</span>
          </a>
        )}
        {profile.phone && (
          <a href={`tel:${profile.phone}`} class="contact-link">
            <span class="icon">☎</span>
            <span>{profile.phone}</span>
          </a>
        )}
        {profile.location && (
          <div class="contact-text">
            <span class="icon">📍</span>
            <span>{profile.location}</span>
          </div>
        )}
        {profile.website && (
          <a href={profile.website} target="_blank" rel="noopener noreferrer" class="contact-link">
            <span class="icon">🌐</span>
            <span>{profile.website.replace(/^https?:\/\//, '')}</span>
          </a>
        )}
      </div>

      {profile.socials && profile.socials.length > 0 && (
        <div class="social-pills">
          {profile.socials.map((social) => (
            <a href={social.url} target="_blank" rel="noopener noreferrer" class="social-pill">
              {social.plattform}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Skills in Sidebar -->
    {skills && skills.length > 0 && (
      <div class="sidebar-section">
        <h2 class="sidebar-heading">{t("skills")}</h2>
        <div class="skills-sidebar">
          {skills.map((cat) => (
            <div class="skill-cat">
              <div class="skill-cat-label">{cat.category}</div>
              <div class="skill-tags">
                {cat.skills.map((s) => (
                  <span class="sidebar-tag">{s}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Languages in Sidebar -->
    {languages && languages.length > 0 && (
      <div class="sidebar-section">
        <h2 class="sidebar-heading">{t("languages")}</h2>
        <div class="lang-stack">
          {languages.map((l) => (
            <div class="lang-row">
              <span class="lang-title">{l.language}</span>
              <span class="lang-badge">{l.fluency}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Certifications in Sidebar -->
    {certifications && certifications.length > 0 && (
      <div class="sidebar-section">
        <h2 class="sidebar-heading">{t("certifications")}</h2>
        <div class="cert-stack">
          {certifications.map((c) => (
            <div class="cert-card">
              <div class="cert-title">
                {c.url ? (
                  <a href={c.url} target="_blank" rel="noopener noreferrer">{c.title} ↗</a>
                ) : (
                  c.title
                )}
              </div>
              <div class="cert-sub">{c.issuer} ({c.date})</div>
            </div>
          ))}
        </div>
      </div>
    )}
  </aside>

  <!-- Right main column / Content -->
  <main class="main-content">
    {profile.bio && (
      <section class="content-section bio-card">
        <h2 class="main-heading">{t("aboutMe")}</h2>
        <p class="bio-text">{profile.bio}</p>
      </section>
    )}

    <!-- Experience -->
    {experience && experience.length > 0 && (
      <section class="content-section">
        <h2 class="main-heading">{t("experience")}</h2>
        <div class="experience-list">
          {experience.map((item) => (
            <article class="exp-card">
              <div class="exp-header">
                <div>
                  <h3 class="role-title">{item.role}</h3>
                  <div class="company-row">
                    <span class="company-name">{item.company}</span>
                    {item.location && <span class="loc-badge">{item.location}</span>}
                  </div>
                </div>
                <div class="period-pill">
                  {item.startDate} – {formatDate(item.endDate, item.current)}
                </div>
              </div>

              {item.description && <p class="exp-desc">{item.description}</p>}

              {item.highlights && item.highlights.length > 0 && (
                <ul class="exp-bullets">
                  {item.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}

              {item.technologies && item.technologies.length > 0 && (
                <div class="tech-pills">
                  {item.technologies.map((t) => (
                    <span class="tech-pill">{t}</span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Projects -->
    {projects && projects.length > 0 && (
      <section class="content-section">
        <h2 class="main-heading">{t("projects")}</h2>
        <div class="project-grid">
          {projects.map((proj) => (
            <article class="proj-card">
              <div class="proj-header">
                <h3 class="proj-title">
                  {proj.url ? (
                    <a href={proj.url} target="_blank" rel="noopener noreferrer">{proj.title} ↗</a>
                  ) : (
                    proj.title
                  )}
                </h3>
              </div>
              {proj.description && <p class="proj-desc">{proj.description}</p>}
              {proj.highlights && proj.highlights.length > 0 && (
                <ul class="proj-bullets">
                  {proj.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
              {proj.technologies && proj.technologies.length > 0 && (
                <div class="tech-pills">
                  {proj.technologies.map((t) => (
                    <span class="tech-pill">{t}</span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Education -->
    {education && education.length > 0 && (
      <section class="content-section">
        <h2 class="main-heading">{t("education")}</h2>
        <div class="edu-list">
          {education.map((edu) => (
            <article class="edu-card">
              <div class="exp-header">
                <div>
                  <h3 class="role-title">{edu.degree} {edu.fieldOfStudy ? `• ${edu.fieldOfStudy}` : ''}</h3>
                  <div class="company-row">
                    <span class="company-name">{edu.institution}</span>
                    {edu.location && <span class="loc-badge">{edu.location}</span>}
                  </div>
                </div>
                <div class="period-pill">
                  {edu.startDate} – {edu.endDate || t("present")}
                </div>
              </div>
              {edu.highlights && edu.highlights.length > 0 && (
                <ul class="exp-bullets">
                  {edu.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </section>
    )}
  </main>
</div>

<style>
  :root {
    --cv-sidebar-bg: #1e293b;
    --cv-sidebar-text: #f8fafc;
    --cv-sidebar-muted: #94a3b8;
    --cv-sidebar-border: #334155;
    --cv-sidebar-pill-bg: #334155;

    --cv-main-bg: #f8fafc;
    --cv-color-card: #ffffff;
    --cv-color-text: #0f172a;
    --cv-color-text-muted: #64748b;
    --cv-color-border: #e2e8f0;
    --cv-color-accent: #0284c7;
    --cv-color-accent-soft: #e0f2fe;
    --cv-font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .cv-sidebar-layout {
    font-family: var(--cv-font-sans);
    display: grid;
    grid-template-columns: 310px 1fr;
    max-width: 1080px;
    margin: 2rem auto;
    background-color: var(--cv-main-bg);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    border: 1px solid var(--cv-color-border);
  }

  /* Sidebar */
  .sidebar {
    background-color: var(--cv-sidebar-bg);
    color: var(--cv-sidebar-text);
    padding: 2.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sidebar-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .avatar-box {
    margin-bottom: 1rem;
  }

  .avatar {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--cv-sidebar-border);
  }

  .sidebar-name {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
    color: var(--cv-sidebar-text);
  }

  .sidebar-title {
    font-size: 0.95rem;
    color: #38bdf8;
    margin: 0.35rem 0 0 0;
    font-weight: 500;
  }

  .sidebar-actions {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.85rem;
    width: 100%;
  }

  .sidebar-pdf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .sidebar-pdf-primary {
    background: #0284c7;
    color: #ffffff;
    border: 1px solid #0284c7;
  }

  .sidebar-pdf-primary:hover {
    background: #0369a1;
    border-color: #0369a1;
    transform: translateY(-1px);
  }

  .sidebar-pdf-secondary {
    background: var(--cv-sidebar-pill-bg);
    color: var(--cv-sidebar-text);
    border: 1px solid #475569;
  }

  .sidebar-pdf-secondary:hover {
    background: #475569;
    transform: translateY(-1px);
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sidebar-heading {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cv-sidebar-muted);
    border-bottom: 1px solid var(--cv-sidebar-border);
    padding-bottom: 0.35rem;
    margin: 0;
  }

  .contact-stack {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .contact-link, .contact-text {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--cv-sidebar-text);
    text-decoration: none;
    word-break: break-all;
  }

  .contact-link:hover {
    color: #38bdf8;
  }

  .social-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .social-pill {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background: var(--cv-sidebar-pill-bg);
    color: var(--cv-sidebar-text);
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .social-pill:hover {
    background: #475569;
  }

  .skills-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skill-cat-label {
    font-size: 0.8rem;
    color: var(--cv-sidebar-muted);
    margin-bottom: 0.3rem;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .sidebar-tag {
    font-size: 0.75rem;
    background-color: var(--cv-sidebar-pill-bg);
    color: #f1f5f9;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .lang-stack {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .lang-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.825rem;
  }

  .lang-badge {
    font-size: 0.75rem;
    color: var(--cv-sidebar-muted);
  }

  .cert-stack {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .cert-card {
    font-size: 0.8rem;
  }

  .cert-title a {
    color: #38bdf8;
    text-decoration: none;
  }

  .cert-sub {
    color: var(--cv-sidebar-muted);
    font-size: 0.75rem;
  }

  /* Main content */
  .main-content {
    padding: 2.5rem 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .content-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bio-card {
    background-color: var(--cv-color-card);
    padding: 1.25rem 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--cv-color-border);
  }

  .bio-text {
    margin: 0;
    font-size: 0.95rem;
    color: var(--cv-color-text-muted);
    line-height: 1.6;
  }

  .main-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--cv-color-text);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .main-heading::before {
    content: "";
    display: inline-block;
    width: 4px;
    height: 1.1rem;
    background-color: var(--cv-color-accent);
    border-radius: 2px;
  }

  .experience-list, .edu-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .exp-card, .edu-card {
    background-color: var(--cv-color-card);
    border: 1px solid var(--cv-color-border);
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .role-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
    color: var(--cv-color-text);
  }

  .company-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.2rem;
  }

  .company-name {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--cv-color-accent);
  }

  .loc-badge {
    font-size: 0.8rem;
    color: var(--cv-color-text-muted);
  }

  .period-pill {
    font-size: 0.775rem;
    font-weight: 500;
    color: var(--cv-color-text-muted);
    background-color: var(--cv-main-bg);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
    border: 1px solid var(--cv-color-border);
  }

  .exp-desc {
    font-size: 0.9rem;
    color: var(--cv-color-text);
    margin: 0;
    line-height: 1.5;
  }

  .exp-bullets {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.875rem;
    color: var(--cv-color-text-muted);
  }

  .exp-bullets li {
    margin-bottom: 0.2rem;
  }

  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.35rem;
  }

  .tech-pill {
    font-size: 0.75rem;
    background-color: var(--cv-color-accent-soft);
    color: var(--cv-color-accent);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .proj-card {
    background-color: var(--cv-color-card);
    border: 1px solid var(--cv-color-border);
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .proj-title {
    font-size: 1rem;
    margin: 0;
    font-weight: 600;
  }

  .proj-title a {
    color: var(--cv-color-accent);
    text-decoration: none;
  }

  .proj-title a:hover {
    text-decoration: underline;
  }

  .proj-desc {
    font-size: 0.875rem;
    color: var(--cv-color-text-muted);
    margin: 0;
  }

  .proj-bullets {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.85rem;
    color: var(--cv-color-text-muted);
  }

  @media (max-width: 820px) {
    .cv-sidebar-layout {
      grid-template-columns: 1fr;
      margin: 0;
      border-radius: 0;
      border: none;
    }
    .sidebar {
      padding: 1.5rem;
    }
    .main-content {
      padding: 1.5rem;
    }
    .exp-header {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
