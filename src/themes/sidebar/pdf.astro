---
import type { CVData } from "../../lib/cvSchema";
import { getTranslations } from "../../lib/i18n";
import { resolveAsset } from "../../lib/assets";

interface Props {
  data: CVData;
  locale?: string;
}

const { data, locale = "en" } = Astro.props;
const { profile, experience, education, skills, projects, certifications, languages } = data;
const t = getTranslations(locale);

function formatDate(dateStr?: string | null, isCurrent?: boolean) {
  if (isCurrent) return t("present");
  if (!dateStr) return "";
  return dateStr;
}
---

<div class="pdf-sidebar-layout">
  <!-- Left column / Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-profile">
      {profile.avatar && (
        <div class="avatar-box">
          <img src={resolveAsset(profile.avatar)} alt={profile.name} class="avatar" />
        </div>
      )}
      <h1 class="sidebar-name">{profile.name}</h1>
      <p class="sidebar-title">{profile.title}</p>
    </div>

    <!-- Contact -->
    <div class="sidebar-section">
      <h2 class="sidebar-heading">{t("contact")}</h2>
      <div class="contact-stack">
        {profile.email && (
          <div class="contact-item">
            <span class="icon">✉</span> {profile.email}
          </div>
        )}
        {profile.phone && (
          <div class="contact-item">
            <span class="icon">☎</span> {profile.phone}
          </div>
        )}
        {profile.location && (
          <div class="contact-item">
            <span class="icon">📍</span> {profile.location}
          </div>
        )}
        {profile.website && (
          <div class="contact-item">
            <span class="icon">🌐</span> {profile.website.replace(/^https?:\/\//, '')}
          </div>
        )}
      </div>

      {profile.socials && profile.socials.length > 0 && (
        <div class="social-pills">
          {profile.socials.map((social) => (
            <span class="social-pill">
              {social.plattform}: {social.username ? `@${social.username}` : ''}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- Skills in Sidebar -->
    {skills && skills.length > 0 && (
      <div class="sidebar-section">
        <h2 class="sidebar-heading">{t("skills")}</h2>
        <div class="skills-sidebar">
          {skills.map((cat) => (
            <div class="skill-cat">
              <div class="skill-cat-label">{cat.category}</div>
              <div class="skill-tags">
                {cat.skills.map((s) => (
                  <span class="sidebar-tag">{s}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Languages in Sidebar -->
    {languages && languages.length > 0 && (
      <div class="sidebar-section">
        <h2 class="sidebar-heading">{t("languages")}</h2>
        <div class="lang-stack">
          {languages.map((l) => (
            <div class="lang-row">
              <span class="lang-title">{l.language}</span>
              <span class="lang-badge">{l.fluency}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Certifications in Sidebar -->
    {certifications && certifications.length > 0 && (
      <div class="sidebar-section">
        <h2 class="sidebar-heading">{t("certifications")}</h2>
        <div class="cert-stack">
          {certifications.map((c) => (
            <div class="cert-card">
              <div class="cert-title">{c.title}</div>
              <div class="cert-sub">{c.issuer} ({c.date})</div>
            </div>
          ))}
        </div>
      </div>
    )}
  </aside>

  <!-- Right main column / Content -->
  <main class="main-content">
    {profile.bio && (
      <section class="content-section bio-card">
        <h2 class="main-heading">{t("aboutMe")}</h2>
        <p class="bio-text">{profile.bio}</p>
      </section>
    )}

    <!-- Experience -->
    {experience && experience.length > 0 && (
      <section class="content-section">
        <h2 class="main-heading">{t("experience")}</h2>
        <div class="experience-list">
          {experience.map((item) => (
            <article class="exp-card">
              <div class="exp-header">
                <div>
                  <h3 class="role-title">{item.role}</h3>
                  <div class="company-row">
                    <span class="company-name">{item.company}</span>
                    {item.location && <span class="loc-badge">• {item.location}</span>}
                  </div>
                </div>
                <div class="period-pill">
                  {item.startDate} – {formatDate(item.endDate, item.current)}
                </div>
              </div>

              {item.description && <p class="exp-desc">{item.description}</p>}

              {item.highlights && item.highlights.length > 0 && (
                <ul class="exp-bullets">
                  {item.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}

              {item.technologies && item.technologies.length > 0 && (
                <div class="tech-pills">
                  {item.technologies.map((t) => (
                    <span class="tech-pill">{t}</span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Projects -->
    {projects && projects.length > 0 && (
      <section class="content-section">
        <h2 class="main-heading">{t("projects")}</h2>
        <div class="project-grid">
          {projects.map((proj) => (
            <article class="proj-card">
              <div class="proj-header">
                <h3 class="proj-title">{proj.title}</h3>
              </div>
              {proj.description && <p class="proj-desc">{proj.description}</p>}
              {proj.highlights && proj.highlights.length > 0 && (
                <ul class="proj-bullets">
                  {proj.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
              {proj.technologies && proj.technologies.length > 0 && (
                <div class="tech-pills">
                  {proj.technologies.map((t) => (
                    <span class="tech-pill">{t}</span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Education -->
    {education && education.length > 0 && (
      <section class="content-section">
        <h2 class="main-heading">{t("education")}</h2>
        <div class="edu-list">
          {education.map((edu) => (
            <article class="edu-card">
              <div class="exp-header">
                <div>
                  <h3 class="role-title">{edu.degree} {edu.fieldOfStudy ? `• ${edu.fieldOfStudy}` : ''}</h3>
                  <div class="company-row">
                    <span class="company-name">{edu.institution}</span>
                    {edu.location && <span class="loc-badge">• {edu.location}</span>}
                  </div>
                </div>
                <div class="period-pill">
                  {edu.startDate} – {edu.endDate || t("present")}
                </div>
              </div>
              {edu.highlights && edu.highlights.length > 0 && (
                <ul class="exp-bullets">
                  {edu.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </section>
    )}
  </main>
</div>

<style>
  .pdf-sidebar-layout {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: grid;
    grid-template-columns: 200px 1fr;
    max-width: 210mm;
    min-height: 297mm;
    margin: 0 auto;
    background-color: #ffffff;
    font-size: 9pt;
    line-height: 1.45;
    box-sizing: border-box;
  }

  @page {
    size: A4 portrait;
    margin: 0mm;
  }

  @media print {
    .pdf-sidebar-layout {
      max-width: 100%;
      min-height: auto;
    }
  }

  /* Sidebar */
  .sidebar {
    background-color: #0f172a;
    color: #f8fafc;
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sidebar-profile {
    text-align: center;
  }

  .avatar-box {
    margin-bottom: 0.5rem;
  }

  .avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #334155;
  }

  .sidebar-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: #f8fafc;
  }

  .sidebar-title {
    font-size: 8.5pt;
    color: #38bdf8;
    margin: 0.2rem 0 0 0;
    font-weight: 500;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .sidebar-heading {
    font-size: 8pt;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #94a3b8;
    border-bottom: 1px solid #334155;
    padding-bottom: 0.2rem;
    margin: 0;
  }

  .contact-stack {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 8pt;
  }

  .contact-item {
    word-break: break-all;
    color: #f1f5f9;
  }

  .social-pills {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 7.5pt;
    color: #cbd5e1;
    margin-top: 0.2rem;
  }

  .skill-cat {
    margin-bottom: 0.3rem;
  }

  .skill-cat-label {
    font-size: 7.5pt;
    color: #94a3b8;
    margin-bottom: 0.15rem;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .sidebar-tag {
    font-size: 7.5pt;
    background-color: #1e293b;
    color: #e2e8f0;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
  }

  .lang-stack {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .lang-row {
    display: flex;
    justify-content: space-between;
    font-size: 7.5pt;
  }

  .lang-badge {
    color: #94a3b8;
  }

  .cert-stack {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cert-title {
    font-size: 8pt;
    font-weight: 600;
    color: #38bdf8;
  }

  .cert-sub {
    color: #94a3b8;
    font-size: 7.5pt;
  }

  /* Main content */
  .main-content {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .content-section {
    break-inside: avoid;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .bio-card {
    background-color: #f8fafc;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    border: 1px solid #e2e8f0;
  }

  .bio-text {
    margin: 0;
    font-size: 8.5pt;
    color: #334155;
  }

  .main-heading {
    font-size: 10pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #0369a1;
    margin: 0;
    border-bottom: 1.5px solid #e0f2fe;
    padding-bottom: 0.2rem;
  }

  .experience-list, .edu-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .exp-card, .edu-card {
    break-inside: avoid;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .role-title {
    font-size: 9.5pt;
    font-weight: 700;
    margin: 0;
    color: #0f172a;
  }

  .company-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .company-name {
    font-size: 8.5pt;
    font-weight: 600;
    color: #0284c7;
  }

  .loc-badge {
    font-size: 8pt;
    color: #64748b;
  }

  .period-pill {
    font-size: 8pt;
    font-weight: 600;
    color: #64748b;
  }

  .exp-desc {
    font-size: 8.5pt;
    color: #1e293b;
    margin: 0.15rem 0;
  }

  .exp-bullets {
    margin: 0;
    padding-left: 1rem;
    font-size: 8pt;
    color: #475569;
  }

  .exp-bullets li {
    margin-bottom: 0.1rem;
  }

  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.2rem;
  }

  .tech-pill {
    font-size: 7.5pt;
    background-color: #f1f5f9;
    color: #0369a1;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-weight: 500;
  }

  .project-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .proj-card {
    break-inside: avoid;
    padding: 0.6rem 0.8rem;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    background-color: #f8fafc;
  }

  .proj-title {
    font-size: 9pt;
    margin: 0;
    font-weight: 700;
  }

  .proj-desc {
    font-size: 8.5pt;
    color: #475569;
    margin: 0.15rem 0;
  }

  .proj-bullets {
    margin: 0;
    padding-left: 1rem;
    font-size: 8pt;
    color: #475569;
  }
</style>
