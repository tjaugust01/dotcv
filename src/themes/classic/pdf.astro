---
import type { CVData } from "../../lib/cvSchema";
import { getTranslations } from "../../lib/i18n";
import { resolveAsset } from "../../lib/assets";

interface Props {
  data: CVData;
  locale?: string;
}

const { data, locale = "en" } = Astro.props;
const { profile, experience, education, skills, projects, certifications, languages } = data;
const t = getTranslations(locale);

function formatDate(dateStr?: string | null, isCurrent?: boolean) {
  if (isCurrent) return t("present");
  if (!dateStr) return "";
  return dateStr;
}
---

<div class="pdf-classic">
  <!-- Header / Profile -->
  <header class="header">
    <div class="header-main">
      {profile.avatar && (
        <div class="avatar-container">
          <img src={resolveAsset(profile.avatar)} alt={profile.name} class="avatar" />
        </div>
      )}
      <div class="profile-info">
        <h1 class="name">{profile.name}</h1>
        <p class="title">{profile.title}</p>
        
        <div class="contact-list">
          {profile.email && (
            <span class="contact-item">
              <span class="icon">✉</span> {profile.email}
            </span>
          )}
          {profile.phone && (
            <span class="contact-item">
              <span class="icon">☎</span> {profile.phone}
            </span>
          )}
          {profile.location && (
            <span class="contact-item">
              <span class="icon">📍</span> {profile.location}
            </span>
          )}
          {profile.website && (
            <span class="contact-item">
              <span class="icon">🌐</span> {profile.website.replace(/^https?:\/\//, '')}
            </span>
          )}
        </div>

        {profile.socials && profile.socials.length > 0 && (
          <div class="social-links">
            {profile.socials.map((social) => (
              <span class="social-link">
                {social.plattform}: {social.username ? `@${social.username}` : social.url.replace(/^https?:\/\//, '')}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>

    {profile.bio && (
      <div class="bio">
        <p>{profile.bio}</p>
      </div>
    )}
  </header>

  <!-- Experience -->
  {experience && experience.length > 0 && (
    <section class="section">
      <h2 class="section-title">{t("experience")}</h2>
      <div class="timeline">
        {experience.map((item) => (
          <article class="item">
            <div class="item-header">
              <div>
                <h3 class="item-title">{item.role}</h3>
                <div class="item-subtitle">
                  <span class="company">{item.company}</span>
                  {item.location && <span class="dot">•</span>}
                  {item.location && <span class="location">{item.location}</span>}
                </div>
              </div>
              <div class="date-badge">
                {item.startDate} – {formatDate(item.endDate, item.current)}
              </div>
            </div>

            {item.description && <p class="item-desc">{item.description}</p>}

            {item.highlights && item.highlights.length > 0 && (
              <ul class="highlights">
                {item.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}

            {item.technologies && item.technologies.length > 0 && (
              <div class="tags">
                {item.technologies.map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Projects -->
  {projects && projects.length > 0 && (
    <section class="section">
      <h2 class="section-title">{t("projects")}</h2>
      <div class="projects-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-header">
              <h3 class="item-title">
                {project.title}
                {project.url && <span class="url-text">({project.url.replace(/^https?:\/\//, '')})</span>}
              </h3>
            </div>
            {project.description && <p class="item-desc">{project.description}</p>}
            {project.highlights && project.highlights.length > 0 && (
              <ul class="highlights">
                {project.highlights.map((hl) => (
                  <li>{hl}</li>
                ))}
              </ul>
            )}
            {project.technologies && project.technologies.length > 0 && (
              <div class="tags">
                {project.technologies.map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Skills -->
  {skills && skills.length > 0 && (
    <section class="section">
      <h2 class="section-title">{t("skills")}</h2>
      <div class="skills-wrapper">
        {skills.map((skillGroup) => (
          <div class="skill-category">
            <h3 class="skill-category-title">{skillGroup.category}</h3>
            <div class="tags">
              {skillGroup.skills.map((skill) => (
                <span class="tag tag-skill">{skill}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Education -->
  {education && education.length > 0 && (
    <section class="section">
      <h2 class="section-title">{t("education")}</h2>
      <div class="timeline">
        {education.map((item) => (
          <article class="item">
            <div class="item-header">
              <div>
                <h3 class="item-title">{item.degree} {item.fieldOfStudy ? `in ${item.fieldOfStudy}` : ''}</h3>
                <div class="item-subtitle">
                  <span class="institution">{item.institution}</span>
                  {item.location && <span class="dot">•</span>}
                  {item.location && <span class="location">{item.location}</span>}
                </div>
              </div>
              <div class="date-badge">
                {item.startDate} – {item.endDate || t("present")}
              </div>
            </div>
            {item.highlights && item.highlights.length > 0 && (
              <ul class="highlights">
                {item.highlights.map((hl) => (
                  <li>{hl}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Certifications & Languages -->
  {((certifications && certifications.length > 0) || (languages && languages.length > 0)) && (
    <div class="split-section">
      {certifications && certifications.length > 0 && (
        <section class="section half">
          <h2 class="section-title">{t("certifications")}</h2>
          <ul class="cert-list">
            {certifications.map((cert) => (
              <li class="cert-item">
                <div class="cert-header">
                  <strong>{cert.title}</strong>
                  <span class="cert-date">{cert.date}</span>
                </div>
                <div class="cert-issuer">{cert.issuer}</div>
              </li>
            ))}
          </ul>
        </section>
      )}

      {languages && languages.length > 0 && (
        <section class="section half">
          <h2 class="section-title">{t("languages")}</h2>
          <ul class="lang-list">
            {languages.map((lang) => (
              <li class="lang-item">
                <span class="lang-name">{lang.language}</span>
                <span class="lang-fluency">{lang.fluency}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )}
</div>

<style>
  .pdf-classic {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #0f172a;
    background-color: #ffffff;
    max-width: 210mm;
    min-height: 297mm;
    margin: 0 auto;
    padding: 12mm 15mm;
    box-sizing: border-box;
    line-height: 1.5;
    font-size: 9.5pt;
  }

  @page {
    size: A4 portrait;
    margin: 12mm 15mm;
  }

  @media print {
    .pdf-classic {
      padding: 0;
      margin: 0;
      max-width: 100%;
      min-height: auto;
    }
  }

  .header {
    border-bottom: 1.5px solid #cbd5e1;
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .header-main {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .avatar {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid #cbd5e1;
  }

  .profile-info {
    flex-grow: 1;
  }

  .name {
    font-size: 1.85rem;
    font-weight: 700;
    margin: 0 0 0.2rem 0;
    color: #0f172a;
    letter-spacing: -0.02em;
  }

  .title {
    font-size: 1.05rem;
    color: #2563eb;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
  }

  .contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 8.5pt;
    color: #475569;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.4rem;
    font-size: 8pt;
    color: #475569;
  }

  .bio {
    margin-top: 0.75rem;
    color: #334155;
    font-size: 9pt;
  }

  .section {
    margin-bottom: 1.5rem;
    break-inside: avoid;
  }

  .section-title {
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1e3a8a;
    border-bottom: 1.5px solid #e2e8f0;
    padding-bottom: 0.25rem;
    margin: 0 0 0.75rem 0;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .item {
    break-inside: avoid;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .item-title {
    font-size: 10pt;
    font-weight: 700;
    margin: 0;
    color: #0f172a;
  }

  .item-subtitle {
    font-size: 9pt;
    color: #475569;
  }

  .company, .institution {
    font-weight: 600;
    color: #2563eb;
  }

  .dot {
    margin: 0 0.3rem;
  }

  .date-badge {
    font-size: 8.5pt;
    font-weight: 600;
    color: #64748b;
    white-space: nowrap;
  }

  .item-desc {
    font-size: 9pt;
    margin: 0.2rem 0;
    color: #1e293b;
  }

  .highlights {
    margin: 0.2rem 0;
    padding-left: 1.1rem;
    font-size: 8.5pt;
    color: #334155;
  }

  .highlights li {
    margin-bottom: 0.15rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.25rem;
  }

  .tag {
    font-size: 7.5pt;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    color: #334155;
  }

  .tag-skill {
    font-size: 8pt;
    padding: 0.15rem 0.5rem;
    font-weight: 500;
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .project-card {
    break-inside: avoid;
    padding: 0.75rem;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    background-color: #f8fafc;
  }

  .url-text {
    font-size: 8pt;
    font-weight: normal;
    color: #64748b;
    margin-left: 0.4rem;
  }

  .skills-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .skill-category-title {
    font-size: 8.5pt;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
    color: #0f172a;
  }

  .split-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    break-inside: avoid;
  }

  .cert-list, .lang-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cert-header {
    display: flex;
    justify-content: space-between;
    font-size: 8.5pt;
  }

  .cert-date {
    color: #64748b;
  }

  .cert-issuer {
    font-size: 8pt;
    color: #64748b;
  }

  .lang-item {
    display: flex;
    justify-content: space-between;
    font-size: 8.5pt;
    padding-bottom: 0.2rem;
    border-bottom: 1px dashed #e2e8f0;
  }
</style>
