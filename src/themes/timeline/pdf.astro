---
import type { CVData } from "../../lib/cvSchema";
import { getTranslations } from "../../lib/i18n";
import { resolveAsset } from "../../lib/assets";

interface Props {
  data: CVData;
  locale?: string;
}

const { data, locale = "en" } = Astro.props;
const { profile, experience, education, skills, projects, certifications, languages } = data;
const t = getTranslations(locale);

function formatDate(dateStr?: string | null, isCurrent?: boolean) {
  if (isCurrent) return t("present");
  if (!dateStr) return "";
  return dateStr;
}
---

<div class="pdf-timeline">
  <!-- Hero Header -->
  <header class="timeline-hero">
    <div class="hero-content">
      {profile.avatar && (
        <div class="avatar-container">
          <img src={resolveAsset(profile.avatar)} alt={profile.name} class="avatar" />
        </div>
      )}
      <div class="hero-text">
        <div class="badge-role">{profile.title}</div>
        <h1 class="name">{profile.name}</h1>
        {profile.bio && <p class="bio">{profile.bio}</p>}

        <div class="meta-row">
          {profile.location && <span class="meta-item">📍 {profile.location}</span>}
          {profile.email && <span class="meta-item">✉ {profile.email}</span>}
          {profile.phone && <span class="meta-item">☎ {profile.phone}</span>}
          {profile.website && <span class="meta-item">🌐 {profile.website.replace(/^https?:\/\//, '')}</span>}
        </div>
      </div>
    </div>
  </header>

  <!-- Experience Roadmap -->
  {experience && experience.length > 0 && (
    <section class="section">
      <div class="section-badge">Career Roadmap</div>
      <h2 class="section-title">{t("experience")}</h2>

      <div class="timeline-track">
        {experience.map((item) => (
          <div class="timeline-node">
            <div class="timeline-marker">
              <span class="marker-dot"></span>
            </div>

            <div class="node-card">
              <div class="node-header">
                <div>
                  <h3 class="node-title">{item.role}</h3>
                  <div class="node-company">
                    <span class="company-name">{item.company}</span>
                    {item.location && <span class="loc-text">• {item.location}</span>}
                  </div>
                </div>
                <div class="node-date">
                  {item.startDate} — {formatDate(item.endDate, item.current)}
                </div>
              </div>

              {item.description && <p class="node-desc">{item.description}</p>}

              {item.highlights && item.highlights.length > 0 && (
                <ul class="node-bullets">
                  {item.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}

              {item.technologies && item.technologies.length > 0 && (
                <div class="tech-chips">
                  {item.technologies.map((t) => (
                    <span class="tech-chip">{t}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Education Roadmap -->
  {education && education.length > 0 && (
    <section class="section">
      <div class="section-badge">Academic Background</div>
      <h2 class="section-title">{t("education")}</h2>

      <div class="timeline-track">
        {education.map((edu) => (
          <div class="timeline-node">
            <div class="timeline-marker">
              <span class="marker-dot"></span>
            </div>

            <div class="node-card">
              <div class="node-header">
                <div>
                  <h3 class="node-title">{edu.degree}</h3>
                  <div class="node-company">
                    <span class="company-name">{edu.institution}</span>
                    {edu.fieldOfStudy && <span class="loc-text">• {edu.fieldOfStudy}</span>}
                    {edu.location && <span class="loc-text">• {edu.location}</span>}
                  </div>
                </div>
                <div class="node-date">
                  {edu.startDate} — {edu.endDate || t("present")}
                </div>
              </div>

              {edu.highlights && edu.highlights.length > 0 && (
                <ul class="node-bullets">
                  {edu.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Projects -->
  {projects && projects.length > 0 && (
    <section class="section">
      <div class="section-badge">Featured Work</div>
      <h2 class="section-title">{t("projects")}</h2>

      <div class="projects-list">
        {projects.map((proj) => (
          <article class="project-box">
            <h3 class="proj-title">
              {proj.title}
              {proj.url && <span class="url-hint">({proj.url.replace(/^https?:\/\//, '')})</span>}
            </h3>
            {proj.description && <p class="node-desc">{proj.description}</p>}
            {proj.highlights && proj.highlights.length > 0 && (
              <ul class="node-bullets">
                {proj.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
            {proj.technologies && proj.technologies.length > 0 && (
              <div class="tech-chips">
                {proj.technologies.map((t) => (
                  <span class="tech-chip">{t}</span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Skills -->
  {skills && skills.length > 0 && (
    <section class="section">
      <div class="section-badge">Expertise</div>
      <h2 class="section-title">{t("skills")}</h2>

      <div class="skills-grid">
        {skills.map((group) => (
          <div class="skill-category">
            <h3 class="cat-title">{group.category}</h3>
            <div class="tech-chips">
              {group.skills.map((s) => (
                <span class="tech-chip skill-chip">{s}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Details (Certifications & Languages) -->
  {((certifications && certifications.length > 0) || (languages && languages.length > 0)) && (
    <div class="split-row">
      {certifications && certifications.length > 0 && (
        <div class="detail-col">
          <h3 class="detail-head">{t("certifications")}</h3>
          <div class="detail-items">
            {certifications.map((c) => (
              <div class="detail-entry">
                <div class="entry-title">{c.title}</div>
                <div class="entry-sub">{c.issuer} ({c.date})</div>
              </div>
            ))}
          </div>
        </div>
      )}

      {languages && languages.length > 0 && (
        <div class="detail-col">
          <h3 class="detail-head">{t("languages")}</h3>
          <div class="detail-items">
            {languages.map((l) => (
              <div class="entry-row">
                <span class="entry-title">{l.language}</span>
                <span class="entry-sub">{l.fluency}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  )}
</div>

<style>
  .pdf-timeline {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #0f172a;
    background-color: #ffffff;
    max-width: 210mm;
    min-height: 297mm;
    margin: 0 auto;
    padding: 12mm 15mm;
    box-sizing: border-box;
    font-size: 9pt;
    line-height: 1.5;
  }

  @page {
    size: A4 portrait;
    margin: 12mm 15mm;
  }

  @media print {
    .pdf-timeline {
      padding: 0;
      margin: 0;
      max-width: 100%;
      min-height: auto;
    }
  }

  .timeline-hero {
    border-bottom: 1.5px solid #e2e8f0;
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .hero-content {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .avatar {
    width: 76px;
    height: 76px;
    border-radius: 16px;
    object-fit: cover;
    border: 1.5px solid #cbd5e1;
  }

  .hero-text {
    flex-grow: 1;
  }

  .badge-role {
    display: inline-block;
    font-size: 7.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #0284c7;
    background: #e0f2fe;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.35rem;
  }

  .name {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem 0;
    color: #0f172a;
  }

  .bio {
    font-size: 8.5pt;
    color: #475569;
    margin: 0 0 0.5rem 0;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 8pt;
    color: #64748b;
  }

  .section {
    margin-bottom: 1.5rem;
    break-inside: avoid;
  }

  .section-badge {
    font-size: 7pt;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: #0284c7;
  }

  .section-title {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 0.75rem 0;
    color: #0f172a;
  }

  /* TIMELINE */
  .timeline-track {
    position: relative;
    padding-left: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .timeline-track::before {
    content: "";
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: 1rem;
    width: 2px;
    background: #cbd5e1;
    transform: translateX(-50%);
  }

  .timeline-node {
    position: relative;
    break-inside: avoid;
  }

  .timeline-marker {
    position: absolute;
    left: -1rem;
    top: 1rem;
    width: 12px;
    height: 12px;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .marker-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ffffff;
    border: 2.5px solid #0284c7;
    box-sizing: border-box;
  }

  .node-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.85rem 1rem;
  }

  .node-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .node-title {
    font-size: 9.5pt;
    font-weight: 700;
    margin: 0;
  }

  .node-company {
    font-size: 8.5pt;
    color: #64748b;
  }

  .company-name {
    color: #0284c7;
    font-weight: 600;
  }

  .node-date {
    font-size: 8pt;
    font-weight: 600;
    color: #64748b;
  }

  .node-desc {
    font-size: 8.5pt;
    color: #1e293b;
    margin: 0.25rem 0;
  }

  .node-bullets {
    margin: 0.2rem 0;
    padding-left: 1rem;
    font-size: 8pt;
    color: #475569;
  }

  .node-bullets li {
    margin-bottom: 0.15rem;
  }

  .tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.35rem;
  }

  .tech-chip {
    font-size: 7.5pt;
    background: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .skill-chip {
    background: #f1f5f9;
  }

  /* Projects */
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-box {
    break-inside: avoid;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.75rem 1rem;
  }

  .proj-title {
    font-size: 9.5pt;
    font-weight: 700;
    margin: 0;
  }

  .url-hint {
    font-size: 7.5pt;
    font-weight: normal;
    color: #64748b;
    margin-left: 0.3rem;
  }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    break-inside: avoid;
  }

  .skill-category {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.6rem 0.8rem;
  }

  .cat-title {
    font-size: 8pt;
    font-weight: 700;
    color: #0284c7;
    margin: 0 0 0.35rem 0;
  }

  /* Split */
  .split-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    break-inside: avoid;
  }

  .detail-col {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.75rem 1rem;
  }

  .detail-head {
    font-size: 9pt;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 0.25rem;
  }

  .detail-items {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .entry-title {
    font-size: 8pt;
    font-weight: 600;
  }

  .entry-sub {
    font-size: 7.5pt;
    color: #64748b;
  }

  .entry-row {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dashed #e2e8f0;
    padding-bottom: 0.15rem;
  }
</style>
