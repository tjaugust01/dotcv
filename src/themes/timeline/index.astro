---
import type { CVData } from "../../lib/cvSchema";
import type { DotcvConfig } from "../../lib/configSchema";
import { getTranslations } from "../../lib/i18n";

interface Props {
  data: CVData;
  locale?: string;
  config?: DotcvConfig;
}

const { data, locale = "en", config } = Astro.props;
const { profile, experience, education, skills, projects, certifications, languages } = data;
const t = getTranslations(locale);

const showAtsButton = config?.pdf?.showAtsButton ?? true;
const showDesignButton = config?.pdf?.showDesignButton ?? true;

function formatDate(dateStr?: string | null, isCurrent?: boolean) {
  if (isCurrent) return t("present");
  if (!dateStr) return "";
  return dateStr;
}
---

<div class="cv-timeline-theme" id="timeline-theme-root">
  <!-- Top Navigation / Actions (PDF Download & Dark Mode Toggle) -->
  <div class="theme-toolbar">
    {showAtsButton && (
      <button type="button" class="pdf-btn pdf-btn-primary" data-print-pdf="ats" aria-label="Download ATS PDF" title="ATS-friendly resume for job applications">
        {t("downloadAtsPdf")}
      </button>
    )}
    {showDesignButton && (
      <button type="button" class="pdf-btn pdf-btn-secondary" data-print-pdf="design" aria-label="Download Design PDF" title="Visual portfolio PDF matching current theme">
        {t("downloadDesignPdf")}
      </button>
    )}
    <button id="theme-toggle-btn" class="toggle-btn" aria-label="Toggle dark/light mode">
      <span class="sun-icon">☀️</span>
      <span class="moon-icon">🌙</span>
      <span class="toggle-text">Mode</span>
    </button>
  </div>

  <!-- Hero Profile Header -->
  <header class="timeline-hero">
    <div class="hero-content">
      {profile.avatar && (
        <div class="hero-avatar-wrapper">
          <img src={profile.avatar} alt={profile.name} class="hero-avatar" />
          <div class="avatar-ring"></div>
        </div>
      )}
      <div class="hero-text">
        <div class="hero-badge">{profile.title}</div>
        <h1 class="hero-name">{profile.name}</h1>
        {profile.bio && <p class="hero-bio">{profile.bio}</p>}

        <div class="hero-meta">
          {profile.location && (
            <span class="meta-item">
              <span class="meta-icon">📍</span> {profile.location}
            </span>
          )}
          {profile.email && (
            <a href={`mailto:${profile.email}`} class="meta-item meta-link">
              <span class="meta-icon">✉️</span> {profile.email}
            </a>
          )}
          {profile.phone && (
            <a href={`tel:${profile.phone}`} class="meta-item meta-link">
              <span class="meta-icon">📱</span> {profile.phone}
            </a>
          )}
          {profile.website && (
            <a href={profile.website} target="_blank" rel="noopener noreferrer" class="meta-item meta-link">
              <span class="meta-icon">🔗</span> {profile.website.replace(/^https?:\/\//, '')}
            </a>
          )}
        </div>

        {profile.socials && profile.socials.length > 0 && (
          <div class="social-tags">
            {profile.socials.map((social) => (
              <a href={social.url} target="_blank" rel="noopener noreferrer" class="social-tag">
                {social.plattform}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </header>

  <!-- Main Content Layout -->
  <main class="timeline-layout">
    <!-- Career & Journey Vertical Timeline -->
    {experience && experience.length > 0 && (
      <section class="timeline-section">
        <div class="section-badge">Career Roadmap</div>
        <h2 class="section-heading">{t("experience")}</h2>

        <div class="timeline-track">
          {experience.map((item) => (
            <div class={`timeline-node ${item.current ? 'is-current' : ''}`}>
              <!-- Timeline Indicator Marker -->
              <div class="timeline-marker">
                <span class="marker-dot"></span>
                <span class="marker-pulse"></span>
              </div>

              <!-- Node Content Box -->
              <div class="node-card">
                <div class="node-header">
                  <div>
                    <h3 class="node-title">{item.role}</h3>
                    <div class="node-company">
                      <span class="company-name">{item.company}</span>
                      {item.location && <span class="location-dot">• {item.location}</span>}
                    </div>
                  </div>
                  <div class="node-date">
                    <span class="date-text">
                      {item.startDate} — {formatDate(item.endDate, item.current)}
                    </span>
                    {item.current && <span class="badge-current">{t("present")}</span>}
                  </div>
                </div>

                {item.description && <p class="node-description">{item.description}</p>}

                {item.highlights && item.highlights.length > 0 && (
                  <ul class="node-highlights">
                    {item.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                )}

                {item.technologies && item.technologies.length > 0 && (
                  <div class="tech-stack">
                    {item.technologies.map((tech) => (
                      <span class="tech-chip">{tech}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Education Timeline -->
    {education && education.length > 0 && (
      <section class="timeline-section">
        <div class="section-badge">Academic Background</div>
        <h2 class="section-heading">{t("education")}</h2>

        <div class="timeline-track">
          {education.map((edu) => (
            <div class="timeline-node">
              <div class="timeline-marker">
                <span class="marker-dot"></span>
              </div>

              <div class="node-card">
                <div class="node-header">
                  <div>
                    <h3 class="node-title">{edu.degree}</h3>
                    <div class="node-company">
                      <span class="company-name">{edu.institution}</span>
                      {edu.fieldOfStudy && <span class="location-dot">• {edu.fieldOfStudy}</span>}
                      {edu.location && <span class="location-dot">• {edu.location}</span>}
                    </div>
                  </div>
                  <div class="node-date">
                    <span class="date-text">{edu.startDate} — {edu.endDate || t("present")}</span>
                  </div>
                </div>

                {edu.highlights && edu.highlights.length > 0 && (
                  <ul class="node-highlights">
                    {edu.highlights.map((hl) => (
                      <li>{hl}</li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Projects Portfolio -->
    {projects && projects.length > 0 && (
      <section class="portfolio-section">
        <div class="section-badge">Featured Work</div>
        <h2 class="section-heading">{t("projects")}</h2>

        <div class="portfolio-grid">
          {projects.map((proj) => (
            <article class="portfolio-card">
              <div class="card-glow"></div>
              <div class="card-header">
                <h3 class="card-title">
                  {proj.url ? (
                    <a href={proj.url} target="_blank" rel="noopener noreferrer" class="external-link">
                      {proj.title} <span class="arrow">↗</span>
                    </a>
                  ) : (
                    proj.title
                  )}
                </h3>
              </div>

              {proj.description && <p class="card-desc">{proj.description}</p>}

              {proj.highlights && proj.highlights.length > 0 && (
                <ul class="card-bullets">
                  {proj.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}

              {proj.technologies && proj.technologies.length > 0 && (
                <div class="tech-stack">
                  {proj.technologies.map((t) => (
                    <span class="tech-chip">{t}</span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Skills Radar / Categories -->
    {skills && skills.length > 0 && (
      <section class="skills-section">
        <div class="section-badge">Expertise</div>
        <h2 class="section-heading">{t("skills")}</h2>

        <div class="skills-cards-grid">
          {skills.map((group) => (
            <div class="skill-box">
              <h3 class="skill-box-title">{group.category}</h3>
              <div class="skill-chips">
                {group.skills.map((skill) => (
                  <span class="skill-chip">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Additional Details (Certifications & Languages) -->
    {((certifications && certifications.length > 0) || (languages && languages.length > 0)) && (
      <div class="bottom-dual-grid">
        {certifications && certifications.length > 0 && (
          <div class="detail-box">
            <h3 class="detail-box-heading">{t("certifications")}</h3>
            <div class="detail-list">
              {certifications.map((c) => (
                <div class="detail-item">
                  <div class="detail-item-header">
                    {c.url ? (
                      <a href={c.url} target="_blank" rel="noopener noreferrer" class="detail-link">
                        {c.title} ↗
                      </a>
                    ) : (
                      <span class="detail-title">{c.title}</span>
                    )}
                    <span class="detail-date">{c.date}</span>
                  </div>
                  <div class="detail-sub">{c.issuer}</div>
                </div>
              ))}
            </div>
          </div>
        )}

        {languages && languages.length > 0 && (
          <div class="detail-box">
            <h3 class="detail-box-heading">{t("languages")}</h3>
            <div class="detail-list">
              {languages.map((l) => (
                <div class="detail-item language-row">
                  <span class="language-name">{l.language}</span>
                  <span class="language-level">{l.fluency}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </main>
</div>

<!-- Theme-specific Toggle Script -->
<script>
  function initThemeToggle() {
    const root = document.getElementById("timeline-theme-root");
    const toggleBtn = document.getElementById("theme-toggle-btn");
    if (!root || !toggleBtn) return;

    // Check localStorage or system preference
    const savedTheme = localStorage.getItem("timeline-color-mode");
    const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    
    const initialMode = savedTheme || (systemPrefersDark ? "dark" : "light");
    root.setAttribute("data-mode", initialMode);

    toggleBtn.addEventListener("click", () => {
      const currentMode = root.getAttribute("data-mode") || "light";
      const nextMode = currentMode === "dark" ? "light" : "dark";
      root.setAttribute("data-mode", nextMode);
      localStorage.setItem("timeline-color-mode", nextMode);
    });
  }

  // Initialize on load and on view transitions
  initThemeToggle();
  document.addEventListener("astro:after-swap", initThemeToggle);
</script>

<style>
  /* Base & Light Mode Variables */
  .cv-timeline-theme {
    --cv-bg: #f8fafc;
    --cv-surface: #ffffff;
    --cv-surface-subtle: #f1f5f9;
    --cv-border: #e2e8f0;
    --cv-border-highlight: #cbd5e1;
    --cv-text: #0f172a;
    --cv-text-muted: #64748b;
    --cv-accent: #2563eb;
    --cv-accent-soft: #eff6ff;
    --cv-accent-glow: rgba(37, 99, 235, 0.15);
    --cv-timeline-line: #e2e8f0;
    --cv-chip-bg: #f1f5f9;
    --cv-chip-text: #334155;
    --cv-radius: 12px;

    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--cv-bg);
    color: var(--cv-text);
    min-height: 100vh;
    padding: 2.5rem 1.5rem;
    transition: background-color 0.25s ease, color 0.25s ease;
    box-sizing: border-box;
  }

  /* Dark Mode Variables (scoped to this theme) */
  .cv-timeline-theme[data-mode="dark"] {
    --cv-bg: #090d16;
    --cv-surface: #111827;
    --cv-surface-subtle: #1e293b;
    --cv-border: #1f2937;
    --cv-border-highlight: #374151;
    --cv-text: #f9fafb;
    --cv-text-muted: #9ca3af;
    --cv-accent: #38bdf8;
    --cv-accent-soft: rgba(56, 189, 248, 0.1);
    --cv-accent-glow: rgba(56, 189, 248, 0.25);
    --cv-timeline-line: #1f2937;
    --cv-chip-bg: #1e293b;
    --cv-chip-text: #e2e8f0;
  }

  /* Theme Toolbar & Actions */
  .theme-toolbar {
    max-width: 900px;
    margin: 0 auto 1.5rem auto;
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .pdf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 20px;
    font-size: 0.825rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pdf-btn-primary {
    background: var(--cv-accent);
    color: #ffffff;
    border: 1px solid var(--cv-accent);
  }

  .pdf-btn-primary:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--cv-accent-glow);
  }

  .pdf-btn-secondary {
    background: var(--cv-accent-soft);
    color: var(--cv-accent);
    border: 1px solid var(--cv-accent);
  }

  .pdf-btn-secondary:hover {
    filter: brightness(0.95);
    transform: translateY(-1px);
  }

  .toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--cv-surface);
    color: var(--cv-text);
    border: 1px solid var(--cv-border);
    padding: 0.45rem 0.9rem;
    border-radius: 20px;
    font-size: 0.825rem;
    font-weight: 500;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    transition: all 0.2s ease;
  }

  .toggle-btn:hover {
    border-color: var(--cv-accent);
    transform: translateY(-1px);
  }

  .cv-timeline-theme[data-mode="dark"] .sun-icon { display: inline-block; }
  .cv-timeline-theme[data-mode="dark"] .moon-icon { display: none; }
  .cv-timeline-theme:not([data-mode="dark"]) .sun-icon { display: none; }
  .cv-timeline-theme:not([data-mode="dark"]) .moon-icon { display: inline-block; }

  /* Hero Header */
  .timeline-hero {
    max-width: 900px;
    margin: 0 auto 3rem auto;
    background: var(--cv-surface);
    border: 1px solid var(--cv-border);
    border-radius: var(--cv-radius);
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .hero-content {
    display: flex;
    gap: 2.25rem;
    align-items: flex-start;
  }

  .hero-avatar-wrapper {
    position: relative;
    flex-shrink: 0;
  }

  .hero-avatar {
    width: 112px;
    height: 112px;
    border-radius: 24px;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 2;
    border: 2px solid var(--cv-border);
  }

  .avatar-ring {
    position: absolute;
    inset: -4px;
    border-radius: 28px;
    background: linear-gradient(135deg, var(--cv-accent), transparent);
    opacity: 0.4;
    z-index: 1;
  }

  .hero-text {
    flex-grow: 1;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.775rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cv-accent);
    background: var(--cv-accent-soft);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    margin-bottom: 0.6rem;
  }

  .hero-name {
    font-size: 2.35rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 0.75rem 0;
    color: var(--cv-text);
  }

  .hero-bio {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--cv-text-muted);
    margin: 0 0 1.25rem 0;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    font-size: 0.875rem;
    color: var(--cv-text-muted);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s;
  }

  .meta-link:hover {
    color: var(--cv-accent);
  }

  .social-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .social-tag {
    font-size: 0.775rem;
    font-weight: 500;
    color: var(--cv-text);
    background: var(--cv-surface-subtle);
    border: 1px solid var(--cv-border);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s;
  }

  .social-tag:hover {
    border-color: var(--cv-accent);
    color: var(--cv-accent);
  }

  /* Main Container */
  .timeline-layout {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Section Headings */
  .section-badge {
    font-size: 0.725rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--cv-accent);
    margin-bottom: 0.25rem;
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 1.75rem 0;
    color: var(--cv-text);
  }

  /* VERTICAL TIMELINE STYLING */
  .timeline-track {
    position: relative;
    padding-left: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* The vertical spine / line */
  .timeline-track::before {
    content: "";
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 1.25rem;
    width: 2px;
    background: var(--cv-timeline-line);
    transform: translateX(-50%);
  }

  .timeline-node {
    position: relative;
  }

  /* Marker node dot */
  .timeline-marker {
    position: absolute;
    left: -1.25rem;
    top: 1.5rem;
    width: 14px;
    height: 14px;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .marker-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--cv-surface);
    border: 3px solid var(--cv-accent);
    box-sizing: border-box;
    z-index: 2;
    transition: transform 0.2s;
  }

  .is-current .marker-dot {
    background: var(--cv-accent);
    box-shadow: 0 0 12px var(--cv-accent);
  }

  .marker-pulse {
    display: none;
  }

  .is-current .marker-pulse {
    display: block;
    position: absolute;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--cv-accent);
    opacity: 0.25;
    animation: pulse 2s infinite ease-out;
  }

  @keyframes pulse {
    0% { transform: scale(0.6); opacity: 0.6; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  .node-card {
    background: var(--cv-surface);
    border: 1px solid var(--cv-border);
    border-radius: var(--cv-radius);
    padding: 1.5rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
    transition: border-color 0.2s, transform 0.2s;
  }

  .node-card:hover {
    border-color: var(--cv-border-highlight);
    transform: translateY(-2px);
  }

  .node-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .node-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: var(--cv-text);
  }

  .node-company {
    font-size: 0.925rem;
    color: var(--cv-text-muted);
    margin-top: 0.2rem;
  }

  .company-name {
    color: var(--cv-accent);
    font-weight: 600;
  }

  .node-date {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.825rem;
    color: var(--cv-text-muted);
    white-space: nowrap;
  }

  .badge-current {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--cv-accent-soft);
    color: var(--cv-accent);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .node-description {
    font-size: 0.925rem;
    line-height: 1.55;
    color: var(--cv-text);
    margin: 0.5rem 0;
  }

  .node-highlights {
    margin: 0.5rem 0;
    padding-left: 1.25rem;
    font-size: 0.875rem;
    color: var(--cv-text-muted);
    line-height: 1.5;
  }

  .node-highlights li {
    margin-bottom: 0.35rem;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .tech-chip {
    font-size: 0.75rem;
    font-weight: 500;
    background: var(--cv-chip-bg);
    color: var(--cv-chip-text);
    border: 1px solid var(--cv-border);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  /* Portfolio Grid */
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 1.25rem;
  }

  .portfolio-card {
    position: relative;
    background: var(--cv-surface);
    border: 1px solid var(--cv-border);
    border-radius: var(--cv-radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: all 0.2s ease;
  }

  .portfolio-card:hover {
    border-color: var(--cv-accent);
    box-shadow: 0 8px 25px var(--cv-accent-glow);
    transform: translateY(-2px);
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
  }

  .external-link {
    color: var(--cv-text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.15s;
  }

  .external-link:hover {
    color: var(--cv-accent);
  }

  .arrow {
    font-size: 0.9rem;
    color: var(--cv-accent);
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--cv-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .card-bullets {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.85rem;
    color: var(--cv-text-muted);
  }

