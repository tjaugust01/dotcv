---
import type { CVData } from "../../lib/cvSchema";
import { getTranslations } from "../../lib/i18n";

interface Props {
  data: CVData;
  locale?: string;
  format?: "a4" | "letter";
}

const { data, locale = "en", format = "a4" } = Astro.props;
const { profile, experience, education, skills, projects, certifications, languages } = data;
const t = getTranslations(locale);

function formatDate(dateStr?: string | null, isCurrent?: boolean) {
  if (isCurrent) return t("present");
  if (!dateStr) return "";
  return dateStr;
}

const contactItems: string[] = [];
if (profile.email) contactItems.push(profile.email);
if (profile.phone) contactItems.push(profile.phone);
if (profile.location) contactItems.push(profile.location);
if (profile.website) contactItems.push(profile.website.replace(/^https?:\/\//, ""));

const socialItems = (profile.socials || []).map((s) => {
  const handle = s.username ? `@${s.username}` : s.url.replace(/^https?:\/\//, "");
  return `${s.plattform}: ${handle}`;
});
---

<div class="ats-resume">
  <!-- Header / Profile (ATS Optimized - Plain text hierarchy) -->
  <header class="ats-header">
    <h1 class="ats-name">{profile.name}</h1>
    {profile.title && <p class="ats-title">{profile.title}</p>}
    
    {contactItems.length > 0 && (
      <p class="ats-contact-line">
        {contactItems.join("  |  ")}
      </p>
    )}

    {socialItems.length > 0 && (
      <p class="ats-contact-line ats-socials">
        {socialItems.join("  |  ")}
      </p>
    )}

    {profile.bio && (
      <p class="ats-bio">{profile.bio}</p>
    )}
  </header>

  <!-- Work Experience -->
  {experience && experience.length > 0 && (
    <section class="ats-section">
      <h2 class="ats-section-title">{t("experience")}</h2>
      <div class="ats-list">
        {experience.map((item) => (
          <article class="ats-item">
            <div class="ats-item-header">
              <span class="ats-item-role"><strong>{item.role}</strong></span>
              <span class="ats-item-date">{item.startDate} – {formatDate(item.endDate, item.current)}</span>
            </div>
            <div class="ats-item-subheader">
              <span class="ats-item-company">{item.company}</span>
              {item.location && <span class="ats-item-location"> | {item.location}</span>}
            </div>

            {item.description && <p class="ats-item-desc">{item.description}</p>}

            {item.highlights && item.highlights.length > 0 && (
              <ul class="ats-highlights">
                {item.highlights.map((hl) => (
                  <li>{hl}</li>
                ))}
              </ul>
            )}

            {item.technologies && item.technologies.length > 0 && (
              <p class="ats-tech-line">
                <strong>Technologies:</strong> {item.technologies.join(", ")}
              </p>
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Education -->
  {education && education.length > 0 && (
    <section class="ats-section">
      <h2 class="ats-section-title">{t("education")}</h2>
      <div class="ats-list">
        {education.map((item) => (
          <article class="ats-item">
            <div class="ats-item-header">
              <span class="ats-item-role">
                <strong>{item.degree}{item.fieldOfStudy ? ` in ${item.fieldOfStudy}` : ""}</strong>
              </span>
              <span class="ats-item-date">{item.startDate} – {item.endDate || t("present")}</span>
            </div>
            <div class="ats-item-subheader">
              <span class="ats-item-company">{item.institution}</span>
              {item.location && <span class="ats-item-location"> | {item.location}</span>}
            </div>

            {item.highlights && item.highlights.length > 0 && (
              <ul class="ats-highlights">
                {item.highlights.map((hl) => (
                  <li>{hl}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Skills (Comma-separated lines for optimal ATS extraction) -->
  {skills && skills.length > 0 && (
    <section class="ats-section">
      <h2 class="ats-section-title">{t("skills")}</h2>
      <div class="ats-skills-container">
        {skills.map((group) => (
          <p class="ats-skill-row">
            <strong>{group.category}:</strong> {group.skills.join(", ")}
          </p>
        ))}
      </div>
    </section>
  )}

  <!-- Projects -->
  {projects && projects.length > 0 && (
    <section class="ats-section">
      <h2 class="ats-section-title">{t("projects")}</h2>
      <div class="ats-list">
        {projects.map((project) => (
          <article class="ats-item">
            <div class="ats-item-header">
              <span class="ats-item-role">
                <strong>{project.title}</strong>
                {project.url && <span class="ats-project-url"> ({project.url.replace(/^https?:\/\//, "")})</span>}
              </span>
            </div>
            {project.description && <p class="ats-item-desc">{project.description}</p>}
            {project.highlights && project.highlights.length > 0 && (
              <ul class="ats-highlights">
                {project.highlights.map((hl) => (
                  <li>{hl}</li>
                ))}
              </ul>
            )}
            {project.technologies && project.technologies.length > 0 && (
              <p class="ats-tech-line">
                <strong>Technologies:</strong> {project.technologies.join(", ")}
              </p>
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Certifications -->
  {certifications && certifications.length > 0 && (
    <section class="ats-section">
      <h2 class="ats-section-title">{t("certifications")}</h2>
      <div class="ats-list">
        {certifications.map((cert) => (
          <article class="ats-item ats-compact-item">
            <div class="ats-item-header">
              <span><strong>{cert.title}</strong> – {cert.issuer}</span>
              <span class="ats-item-date">{cert.date}</span>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Languages -->
  {languages && languages.length > 0 && (
    <section class="ats-section">
      <h2 class="ats-section-title">{t("languages")}</h2>
      <p class="ats-languages-line">
        {languages.map((l) => `${l.language} (${l.fluency})`).join("  |  ")}
      </p>
    </section>
  )}
</div>

<style define:vars={{ pageSize: format === "letter" ? "letter" : "a4" }}>
  .ats-resume {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, Helvetica, sans-serif;
    color: #111827;
    background-color: #ffffff;
    line-height: 1.45;
    font-size: 10pt;
    max-width: 210mm;
    min-height: 297mm;
    margin: 0 auto;
    padding: 15mm 18mm;
    box-sizing: border-box;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  @page {
    size: var(--pageSize) portrait;
    margin: 15mm 18mm;
  }

  @media print {
    .ats-resume {
      padding: 0;
      margin: 0;
      max-width: 100%;
      min-height: auto;
    }
  }

  /* Header */
  .ats-header {
    text-align: center;
    border-bottom: 1.5pt solid #111827;
    padding-bottom: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .ats-name {
    font-size: 20pt;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 0.2rem 0;
    text-transform: uppercase;
    color: #000000;
  }

  .ats-title {
    font-size: 11pt;
    font-weight: 600;
    color: #374151;
    margin: 0 0 0.35rem 0;
  }

  .ats-contact-line {
    font-size: 9pt;
    color: #4b5563;
    margin: 0.15rem 0;
  }

  .ats-socials {
    font-size: 8.5pt;
  }

  .ats-bio {
    font-size: 9pt;
    color: #374151;
    margin: 0.6rem auto 0 auto;
    text-align: justify;
    line-height: 1.4;
  }

  /* Sections */
  .ats-section {
    margin-bottom: 1.2rem;
    break-inside: auto;
  }

  .ats-section-title {
    font-size: 11pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #000000;
    border-bottom: 1pt solid #4b5563;
    padding-bottom: 0.2rem;
    margin: 0 0 0.65rem 0;
    break-after: avoid;
    page-break-after: avoid;
  }

  .ats-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .ats-item {
    break-inside: avoid;
    page-break-inside: avoid;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .ats-compact-item {
    gap: 0;
  }

  .ats-item-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 10pt;
  }

  .ats-item-role {
    color: #000000;
  }

  .ats-project-url {
    font-size: 8.5pt;
    font-weight: normal;
    color: #4b5563;
  }

  .ats-item-date {
    font-size: 9pt;
    font-weight: 600;
    color: #374151;
    white-space: nowrap;
  }

  .ats-item-subheader {
    font-size: 9.5pt;
    color: #374151;
  }

  .ats-item-company {
    font-style: italic;
  }

  .ats-item-desc {
    font-size: 9.25pt;
    margin: 0.2rem 0;
    color: #1f2937;
  }

  .ats-highlights {
    margin: 0.15rem 0 0.25rem 0;
    padding-left: 1.25rem;
    font-size: 9pt;
    color: #1f2937;
  }

  .ats-highlights li {
    margin-bottom: 0.15rem;
  }

  .ats-tech-line {
    font-size: 8.5pt;
    color: #4b5563;
    margin: 0.15rem 0 0 0;
  }

  /* Skills & Languages */
  .ats-skills-container {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .ats-skill-row {
    font-size: 9.25pt;
    margin: 0;
    color: #1f2937;
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .ats-languages-line {
    font-size: 9.25pt;
    margin: 0;
    color: #1f2937;
  }
</style>
